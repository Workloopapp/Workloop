platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # First-party SDK used by Workloop's native Tap to Pay bridge.
  pod 'StripeTerminal', '~> 5.7'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |configuration|
      if target.name == 'geolocator_apple'
        configuration.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        configuration.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'BYPASS_PERMISSION_LOCATION_ALWAYS=1'
      end
      deployment_target = configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new('15.0')
        configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    next unless target.respond_to?(:shell_script_build_phases)

    phase = target.shell_script_build_phases.find { |build_phase| build_phase.name == 'Strip Extended Attributes' }
    phase ||= target.new_shell_script_build_phase('Strip Extended Attributes')
    phase.shell_script = <<~SCRIPT
      if [ -n "$TARGET_BUILD_DIR" ] && [ -n "$WRAPPER_NAME" ]; then
        /usr/bin/xattr -cr "$TARGET_BUILD_DIR/$WRAPPER_NAME" || true
      fi
    SCRIPT
  end

  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner', 'Pods-Runner-frameworks.sh')).each do |frameworks_script|
    contents = File.read(frameworks_script)
    next if contents.include?('Workloop: strip extended attributes before signing embedded frameworks')

    contents.gsub!(
      '  code_sign_if_enabled "${destination}/$(basename "$1")"',
      <<~SCRIPT.chomp
        # Workloop: strip extended attributes before signing embedded frameworks.
        /usr/bin/xattr -cr "${destination}/$(basename "$1")" || true
        code_sign_if_enabled "${destination}/$(basename "$1")"
      SCRIPT
    )
    File.write(frameworks_script, contents)
  end
end
