GOOGLE_PLACES_API_KEY=replace-with-a-places-api-restricted-server-key
PLACES_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
BOOKING_REQUEST_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
ACCOUNT_DELETION_ADMIN_TOKEN=replace-with-a-long-random-admin-token
OPERATIONS_ALERT_EMAIL=support@workloop.uk
# Client-initiated payment actions remain closed until this is deliberately set.
WORKLOOP_PAYMENTS_BETA_ENABLED=false
RESEND_API_KEY=re_replace_me
BOOKING_CONFIRMATION_EMAIL_FROM=Workloop <bookings@workloop.uk>
BOOKING_CONFIRMATION_DRAIN_TOKEN=replace-with-at-least-32-random-characters
# Stripe remains test-only until STRIPE_LIVE_MODE_ALLOWED is deliberately set.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_REFRESH_URL=https://example.com/payments/connect/refresh
STRIPE_CONNECT_RETURN_URL=https://example.com/payments/connect/return
STRIPE_CHECKOUT_SUCCESS_URL=https://example.com/payments/success
STRIPE_CHECKOUT_CANCEL_URL=https://example.com/payments/cancel
WORKLOOP_PLATFORM_FEE_BPS=0
WORKLOOP_PLATFORM_FEE_ENABLED=false
STRIPE_LIVE_MODE_ALLOWED=false
APPLE_APP_STORE_CONNECT_ISSUER_ID=replace-with-app-store-connect-issuer-id
APPLE_ANALYTICS_KEY_ID=replace-with-sales-and-reports-key-id
APPLE_ANALYTICS_PRIVATE_KEY=replace-with-sales-and-reports-p8-key
APPLE_TESTFLIGHT_KEY_ID=replace-with-developer-key-id
APPLE_TESTFLIGHT_PRIVATE_KEY=replace-with-developer-p8-key
APPLE_APP_ID=replace-with-app-store-connect-app-id
# Apple provider credentials used only by the scheduled server-side push
# worker. Keep the private key in Supabase secrets, never in the app.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.ismaeel.workloop
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=production

# Booking SMS is disabled until the Twilio account, separate reminder Messaging
# Service, reply-capable sender, Advanced Opt-Out and webhooks are verified.
# Reuse the Twilio account for Auth, but keep OTP on a separate Verify/service.
BOOKING_SMS_ENABLED=false
TWILIO_REMINDER_SERVICE_READY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_REMINDER_MESSAGING_SERVICE_SID=
TWILIO_SMS_WEBHOOK_BASE_URL=
BOOKING_SMS_GLOBAL_DAILY_LIMIT=1000
BOOKING_SMS_WORKSPACE_DAILY_LIMIT=100
BOOKING_SMS_PHONE_DAILY_LIMIT=6
## Account deletion: the platform client IDs shown in Stripe Connect OAuth settings.
## Required to disconnect independently owned Standard accounts (not close them).
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_TEST_CLIENT_ID=
